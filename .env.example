GATEWAY_PORT=4000
DETECTION_SERVICE_URL=http://python-detection:8000
MONGODB_URI=mongodb://mongodb:27017/sentinelai
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@sentinelai.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DASHBOARD_ORIGIN=http://localhost:5173

RISK_MODEL_PROVIDER=local
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=

VECTOR_MODEL_NAME=all-MiniLM-L6-v2
NER_MODEL_NAME=dslim/bert-base-NER
FAISS_INDEX_PATH=./data/company_index.faiss

# NOTE (v1.1): these three seed the initial `policy_config` Mongo document
# only (see node-gateway/scripts/seedPolicyConfig.js). At runtime
# risk_engine.py reads live policy from Mongo via policyCache.js, falling
# back to its own hardcoded DEFAULT_THRESHOLDS if Mongo/policy_config is
# unavailable -- these vars are documentation of that fallback shape, not
# read directly by risk_engine.py itself.
RISK_THRESHOLD_SAFE_MAX=29
RISK_THRESHOLD_LOW_MAX=59
RISK_THRESHOLD_HIGH_MAX=79

POLICY_CACHE_TTL_SECONDS=30
